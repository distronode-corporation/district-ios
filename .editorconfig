# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Matches `--indent 4` in .swiftformat, which is what CI enforces.
[*.swift]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Trailing whitespace is significant in Markdown (two spaces is a hard line break).
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
